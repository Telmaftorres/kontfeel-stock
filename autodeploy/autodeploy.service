[Unit]
Description=Kontfeel Stock — webhook autodeploy
After=network.target docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/kontfeel-stock/autodeploy
ExecStart=/usr/bin/python3 server.py
Restart=always
RestartSec=5
Environment=DEPLOY_SECRET=REMPLACER_PAR_SECRET
Environment=REPO_DIR=/home/ubuntu/kontfeel-stock
Environment=DEPLOY_PORT=9000

[Install]
WantedBy=multi-user.target
